    function spawnNextFallingQuestion() {
      answersGrid.innerHTML = ''; typedBuffer = ""; distractorBtnElements = [];
      if (gamePlayMode === 'kimaru' && window.kimaruTarget && window.kimaruDerivedIndex < window.kimaruDerivedList.length) {
        currentTarget = window.kimaruTarget; currentDerivedList = window.kimaruDerivedList; currentDerivedIndex = window.kimaruDerivedIndex; targetCleanSpellList = currentTarget.q.split('/').map(s => s.replace(/[-_() ]/g, '').toLowerCase().trim());
