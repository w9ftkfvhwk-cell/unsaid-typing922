<!DOCTYPE html>
<html lang="ja" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Unsaid - Sepia Tavern (Large Font Edition)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            tavernDark: '#2a1a12',
            tavernPanel: '#3a2419',
            sepiaGold: '#d97706',
            amberGlow: '#f59e0b'
          },
          fontFamily: {
            cinzel: ['Cinzel', 'serif'],
            serif: ['"Playfair Display"', 'serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          }
        }
      }
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=JetBrains+Mono:wght@500;700&family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap&subset=cyrillic');
    body { background-color: #2a1a12; color: #f3f4f6; overflow: hidden; touch-action: manipulation; user-select: none; -webkit-user-select: none; }
    .tavern-bg { background: radial-gradient(circle at 50% 30%, rgba(135, 85, 55, 0.8) 0%, rgba(65, 45, 30, 0.95) 85%), linear-gradient(180deg, #4a3429 0%, #2a1a12 100%); }
    .sepia-panel { background: rgba(68, 46, 36, 0.95); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(217, 119, 6, 0.5); box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5); }
    .sepia-btn { background: rgba(217, 119, 6, 0.2); border: 1px solid rgba(217, 119, 6, 0.4); transition: all 0.2s; }
    .sepia-btn:hover { background: rgba(217, 119, 6, 0.4); border-color: rgba(245, 158, 11, 0.8); }
    .shake { animation: shakeAnim 0.25s ease-in-out; }
    @keyframes shakeAnim { 0%, 100% { transform: translate(0, 0); } 20% { transform: translate(-4px, 3px); } 40% { transform: translate(4px, -3px); } 60% { transform: translate(-3px, -2px); } 80% { transform: translate(3px, 2px); } }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-thumb { background: rgba(217, 119, 6, 0.6); border-radius: 6px; }
    body.theme-midnight { filter: hue-rotate(180deg) saturate(1.2) brightness(0.9); }
    body.theme-emerald { filter: hue-rotate(260deg) saturate(1.2) brightness(1.0); }
  </style>
</head>
<body class="tavern-bg h-[100dvh] w-screen relative flex flex-col justify-between overflow-hidden font-serif text-amber-50">

  <!-- X(Twitter)アクセス制限用ガード画面 -->
  <div id="xGateScreen" class="fixed inset-0 z-50 bg-[#120b08] flex flex-col justify-center items-center p-6 text-center">
    <div class="sepia-panel p-8 rounded-3xl max-w-sm w-full border border-amber-500/50 shadow-2xl space-y-4">
      <div class="text-4xl">🔒</div>
      <h2 class="text-xl font-bold font-cinzel text-amber-100">X 会員限定アクセス</h2>
      <p class="text-xs text-amber-200 leading-relaxed">
        このアプリは <b>X（Twitter）のプロフィールリンク</b> からアクセスした方のみご利用いただけます。
      </p>
      <div class="pt-2">
        <a href="https://x.com" id="xProfileLink" class="block w-full py-3 rounded-xl bg-black border border-amber-500/60 text-amber-300 font-bold text-sm hover:bg-amber-950 transition">
          𝕏 プロフィールへ戻る
        </a>
      </div>
    </div>
  </div>

  <canvas id="bgCanvas" class="absolute inset-0 z-0 pointer-events-none"></canvas>

  <header class="relative z-30 w-full px-4 py-3 flex justify-between items-center bg-stone-900/60 border-b border-sepiaGold/40 shadow-md">
    <div class="flex items-center space-x-2">
      <div class="w-3 h-3 rounded-full bg-sepiaGold animate-pulse"></div>
      <span class="font-cinzel font-black tracking-widest text-amber-100 text-2xl">Unsaid</span>
    </div>

    <div id="gameHud" class="hidden flex items-center space-x-4 sm:space-x-8">
      <div class="text-right"><div class="text-[11px] text-amber-300 font-mono">SCORE</div><div id="hudScore" class="font-mono text-amber-50 font-bold text-xl leading-none">0</div></div>
      <div class="text-right"><div class="text-[11px] text-amber-300 font-mono">CHAIN</div><div id="hudCombo" class="font-mono text-amber-200 font-bold text-xl leading-none">0</div></div>
      <div class="text-right"><div class="text-[11px] text-amber-300 font-mono">TIME</div><div id="hudTimer" class="font-mono text-rose-300 font-bold text-xl leading-none">60s</div></div>
    </div>

    <div class="flex items-center space-x-3">
      <button id="bgmBtn" class="px-3 py-2 rounded-full sepia-btn text-amber-200 hover:text-white flex items-center text-sm font-bold shadow-md">
        <span id="bgmIcon" class="mr-1">▶️</span> 
        <span id="bgmStatus" class="text-xs font-mono text-slate-400">BGM 停止</span>
      </button>
      <button id="homeBtn" onclick="forceReturnHome()" class="hidden p-2.5 rounded-full sepia-btn text-amber-200 hover:text-white text-lg" title="メニューに戻る">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
      </button>
    </div>
  </header>

  <div id="feverBanner" class="absolute top-20 left-0 w-full z-20 pointer-events-none opacity-0 transition-opacity duration-300 flex justify-center items-center">
    <div class="px-8 py-2 rounded-full bg-amber-900/90 border border-amber-400 text-amber-100 font-cinzel font-bold text-sm animate-bounce shadow-2xl">🍷 FEVER MODE x2 🍷</div>
  </div>

  <!-- MENU SCREEN -->
  <div id="menuScreen" class="relative z-30 flex-1 flex flex-col justify-start items-center px-4 max-w-lg mx-auto w-full space-y-4 overflow-y-auto py-6 pb-12">
    <div class="text-center py-2 space-y-2">
      <h1 class="text-5xl sm:text-7xl font-cinzel font-black tracking-widest text-amber-50 drop-shadow-md">Unsaid</h1>
      <p class="text-sm sm:text-base text-amber-200 font-serif tracking-wider">英単語の語根とスペルを深める</p>
    </div>

    <div class="w-full sepia-panel rounded-xl p-1.5 grid grid-cols-2 gap-1.5 border border-sepiaGold/40 mb-1 shadow-sm">
      <button id="modeAutoBtn" onclick="setGamePlayMode('auto')" class="py-2.5 rounded-lg font-bold text-sm sm:text-base transition flex items-center justify-center space-x-1 text-amber-300 hover:text-amber-100"><span>▶️ 自動再生</span></button>
      <button id="modeChoiceBtn" onclick="setGamePlayMode('choice')" class="py-2.5 rounded-lg font-bold text-sm sm:text-base transition flex items-center justify-center space-x-1 text-amber-300 hover:text-amber-100"><span>⚡ 4択</span></button>
      <button id="modeTypingBtn" onclick="setGamePlayMode('typing')" class="py-2.5 rounded-lg font-bold text-sm sm:text-base transition flex items-center justify-center space-x-1 text-amber-300 hover:text-amber-100"><span>⌨️ タイピング</span></button>
      <button id="modeKimaruBtn" onclick="setGamePlayMode('kimaru')" class="py-2.5 rounded-lg font-bold text-sm sm:text-base transition flex items-center justify-center space-x-1 text-amber-300 hover:text-amber-100"><span>🧠 KIMARU</span></button>
    </div>

    <div class="w-full sepia-panel rounded-xl p-3 border border-sepiaGold/40 flex items-center justify-between text-sm shadow-sm">
      <span class="text-amber-300 font-bold">⏱️ 速度:</span>
      <div class="flex space-x-2 text-sm">
        <button id="speedSlowBtn" onclick="setSpeedLevel('slow')" class="px-3 py-1.5 rounded-lg font-bold text-amber-300 hover:text-amber-100">ゆったり</button>
        <button id="speedNormalBtn" onclick="setSpeedLevel('normal')" class="px-3 py-1.5 rounded-lg font-bold text-amber-300 hover:text-amber-100">普通</button>
        <button id="speedFastBtn" onclick="setSpeedLevel('fast')" class="px-3 py-1.5 rounded-lg font-bold text-amber-300 hover:text-amber-100">速い</button>
      </div>
    </div>

    <div class="w-full space-y-3">
      <div class="flex rounded-xl bg-black/40 p-1.5 border border-sepiaGold/40 text-sm sm:text-base shadow-sm">
        <button id="tabAffix" onclick="selectRootOrigin('affix')" class="flex-1 py-2 font-bold rounded-lg transition text-amber-300 hover:text-amber-100">接辞</button>
        <button id="tabLatin" onclick="selectRootOrigin('latin')" class="flex-1 py-2 font-bold rounded-lg transition text-amber-300 hover:text-amber-100">ラテン</button>
        <button id="tabGermanic" onclick="selectRootOrigin('germanic')" class="flex-1 py-2 font-bold rounded-lg transition text-amber-300 hover:text-amber-100">ゲルマン</button>
        <button id="tabGreek" onclick="selectRootOrigin('greek')" class="flex-1 py-2 font-bold rounded-lg transition text-amber-300 hover:text-amber-100">ギリシャ</button>
      </div>
      <div id="stageListContainer" class="space-y-3 w-full pb-2"></div>
      
      <div class="w-full space-y-3 pt-4 border-t border-sepiaGold/30 pb-8">
        <button onclick="startExamMode()" class="w-full py-4 rounded-xl font-black text-lg sm:text-xl bg-gradient-to-r from-amber-600 to-amber-800 text-amber-50 shadow-[0_0_15px_rgba(217,119,6,0.6)] transform active:scale-95 transition border border-amber-400">
          👑 苦手特化・全語根エンドレス検定
        </button>
        
        <button onclick="startAllRootAutoPlay()" class="w-full py-3 rounded-xl font-bold text-base sm:text-lg bg-black/60 border border-amber-500/50 text-amber-200 shadow-md hover:bg-amber-900/40 transform active:scale-95 transition">
          🎧 全語根エンドレス自動再生 (シャッフルなし・派生語1つ)
        </button>

        <div class="flex space-x-3 pt-2">
          <div class="flex-1 sepia-panel rounded-xl p-3 border border-sepiaGold/40 shadow-sm">
            <div class="text-xs text-amber-300 font-bold mb-2">🎨 テーマ</div>
            <select id="themeSelect" onchange="changeTheme(this.value)" class="w-full bg-black/60 text-amber-100 text-sm p-1.5 rounded-lg border border-sepiaGold/30 outline-none focus:border-amber-500">
              <option value="sepia">セピア酒場 (Sepia)</option>
              <option value="midnight">真夜中の書庫 (Midnight)</option>
              <option value="emerald">賢者の森 (Emerald)</option>
            </select>
          </div>
          <div class="flex-1 sepia-panel rounded-xl p-3 border border-sepiaGold/40 shadow-sm">
            <div class="text-xs text-amber-300 font-bold mb-2">🎵 BGM</div>
            <select id="bgmSelect" onchange="sound.changeTrack(parseInt(this.value))" class="w-full bg-black/60 text-amber-100 text-sm p-1.5 rounded-lg border border-sepiaGold/30 outline-none focus:border-amber-500">
              <option value="1">1. 静かな酒場</option>
              <option value="2">2. クリスタル</option>
              <option value="3">3. 集中と緊張</option>
            </select>
            <div class="text-[9px] text-amber-500 mt-1">※右上の▶で再生（マナーモード解除必須）</div>
          </div>
        </div>
        
        <div class="mt-3 sepia-panel rounded-xl p-3 border border-sepiaGold/40 shadow-sm">
          <div class="text-xs text-amber-300 font-bold mb-2">🗣️ 発音の再生速度</div>
          <select id="voiceRateSelect" onchange="sound.changeVoiceRate(parseFloat(this.value))" class="w-full bg-black/60 text-amber-100 text-sm p-1.5 rounded-lg border border-sepiaGold/30 outline-none focus:border-amber-500">
            <option value="0.6">ゆっくり (0.6x)</option>
            <option value="0.9" selected>標準 (0.9x)</option>
            <option value="1.2">やや速い (1.2x)</option>
            <option value="1.5">速い (1.5x)</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- GAME SCREEN -->
  <div id="gameScreen" class="hidden relative z-10 flex-1 flex flex-col justify-between p-4 max-w-lg mx-auto w-full h-full overflow-hidden">
    <div class="w-full h-2 bg-black/50 rounded-full overflow-hidden z-20 border border-sepiaGold/40">
      <div id="feverBar" class="h-full w-0 bg-amber-400 transition-all duration-300 shadow-[0_0_8px_#f59e0b]"></div>
    </div>

    <div id="kimaruRootInfoArea" class="hidden w-full z-20 mt-4 text-center">
      <div class="text-[14px] text-amber-200 font-bold mb-1 bg-black/60 rounded-full py-2 px-6 inline-block border border-amber-500/50 shadow-md">
        💡 語根: <span id="kimaruRootMeaning" class="text-amber-400 text-xl mx-1"></span> <span id="kimaruRootSpell" class="hidden"></span>
      </div>
    </div>

    <div id="playArea" class="relative flex-1 w-full my-4 overflow-hidden flex justify-center items-center">
      <div id="deadlineBarContainer" class="absolute bottom-0 left-0 w-full h-1.5 bg-black/60 z-10 rounded-full transition-opacity duration-300">
        <div id="deadlineBarFill" class="h-full bg-rose-600/80 w-full shadow-[0_0_8px_rgba(225,29,72,0.8)] transition-all ease-linear"></div>
      </div>

      <div id="fallingCard" class="w-[94%] max-w-[420px] sepia-panel rounded-2xl p-6 text-center border-t border-sepiaGold/60 pointer-events-auto break-words shadow-2xl relative z-20">
        <button onclick="speakCurrentDerived()" class="absolute top-3 right-3 p-2 text-amber-200 hover:text-white transition bg-amber-900/40 rounded-xl border border-amber-600/40 shadow-sm z-30" title="発音を聞く">🔊</button>
        
        <div id="questionCategory" class="text-xs font-mono tracking-widest text-amber-300 mb-2 font-bold">STAGE</div>
        
        <div class="border-b border-sepiaGold/40 pb-4 mb-4">
          <div id="rootSpellText" class="text-3xl sm:text-5xl font-bold text-amber-50 tracking-wide font-mono drop-shadow-md break-words">---</div>
          <div id="rootMeaningText" class="text-lg sm:text-xl text-amber-200 font-bold mt-2">---</div>
        </div>

        <div class="min-h-[5rem] flex flex-col justify-center items-center w-full">
           <div class="flex items-center w-full justify-center">
             <div id="derivedSpellText" class="text-xl sm:text-3xl font-bold text-amber-100 tracking-wider font-mono break-words leading-tight text-center">---</div>
           </div>
           <div id="derivedMeaningText" class="text-base sm:text-lg text-amber-200 font-bold mt-3 text-center">---</div>
        </div>

        <div id="typingGuideArea" class="hidden mt-4 pt-4 border-t border-sepiaGold/30">
          <div id="typedBufferDisplay" class="font-mono text-xl sm:text-3xl font-bold tracking-widest text-amber-200 min-h-[2.5rem] bg-black/60 rounded-lg py-2 px-3 sm:px-6 border border-amber-600/50 inline-block shadow-inner break-all"></div>
        </div>
      </div>
    </div>

    <div id="interactivePad" class="mb-4 w-full z-30">
      <div id="answersGrid" class="grid grid-cols-2 gap-3 w-full"></div>
      <div id="virtualKeyboard" class="hidden sepia-panel rounded-2xl p-3 border border-sepiaGold/40 space-y-2 shadow-md">
        <div class="flex justify-center space-x-1.5" id="kbRow1"></div>
        <div class="flex justify-center space-x-1.5" id="kbRow2"></div>
        <div class="flex justify-center space-x-1.5" id="kbRow3"></div>
      </div>
    </div>
  </div>

  <!-- RESULT SCREEN -->
  <div id="resultScreen" class="hidden relative z-30 flex-1 flex flex-col justify-center items-center px-4 max-w-lg mx-auto w-full text-center py-6 overflow-y-auto space-y-6">
    <div class="sepia-panel w-full rounded-3xl p-8 border border-sepiaGold/50 space-y-6 max-h-[85vh] overflow-y-auto shadow-2xl">
      <div id="rankBadge" class="text-7xl font-mono font-bold text-amber-300 drop-shadow-[0_0_15px_rgba(251,191,36,0.5)]">S</div>
      <div>
        <h2 class="text-3xl font-bold text-amber-50 font-cinzel">STAGE CLEAR</h2>
        <div id="passNotification" class="text-sm text-emerald-400 font-bold mt-2 hidden">🎉 クリア！</div>
      </div>
      <div class="grid grid-cols-2 gap-4 pt-4 border-t border-sepiaGold/30 font-mono">
        <div class="bg-black/40 rounded-2xl p-4 border border-sepiaGold/30"><div class="text-xs text-amber-300">SCORE</div><div id="resultScore" class="text-2xl font-bold text-amber-100">0</div></div>
        <div class="bg-black/40 rounded-2xl p-4 border border-sepiaGold/30"><div class="text-xs text-amber-300">MAX CHAIN</div><div id="resultCombo" class="text-2xl font-bold text-amber-300">0</div></div>
        <div class="bg-black/40 rounded-2xl p-4 border border-sepiaGold/30"><div class="text-xs text-amber-300">ACCURACY</div><div id="resultAccuracy" class="text-2xl font-bold text-rose-300">100%</div></div>
        <div class="bg-black/40 rounded-2xl p-4 border border-sepiaGold/30"><div class="text-xs text-amber-300">SPEED (CPM)</div><div id="resultSpeed" class="text-2xl font-bold text-slate-100">0</div></div>
      </div>
      
      <div class="flex space-x-3 pt-4">
        <button onclick="forceReturnHome()" class="flex-1 py-4 bg-stone-800 text-amber-100 border border-sepiaGold/50 font-bold rounded-2xl hover:bg-stone-700 transition text-sm sm:text-base shadow-md">MENU</button>
        <button onclick="restartGame()" class="flex-1 py-4 bg-amber-700 text-amber-50 font-bold rounded-2xl hover:bg-amber-600 transition text-sm sm:text-base shadow-md">もう一度</button>
        <button id="nextStageBtn" class="hidden flex-1 py-4 bg-amber-500 text-amber-950 font-bold rounded-2xl hover:bg-amber-400 transition text-sm sm:text-base shadow-md">NEXT ➔</button>
      </div>
    </div>
  </div>

  <script>
    (function checkXAccess() {
      const urlParams = new URLSearchParams(window.location.search);
      const isFromXParam = urlParams.get('ref') === 'x' || urlParams.get('from') === 'x';
      const ref = document.referrer.toLowerCase();
      const isFromXReferrer = ref.includes('t.co') || ref.includes('twitter.com') || ref.includes('x.com');
      const isTwitterUA = /Twitter/i.test(navigator.userAgent);
      if (isFromXParam || isFromXReferrer || isTwitterUA) {
        document.getElementById('xGateScreen').classList.add('hidden');
      } else {
        document.getElementById('xGateScreen').classList.remove('hidden');
      }
    })();

