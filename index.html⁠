        }
      }

      const pairStr = currentDerivedList[currentDerivedIndex] || "";
      const dSpell = pairStr.split(':')[0].replace(/・/g, '').toLowerCase();
      
      if (gamePlayMode === 'kimaru') {
        currentActiveTargetSpell = dSpell;
      } else {
        const sortedSpells = [...targetCleanSpellList].sort((a, b) => b.length - a.length);
        currentActiveTargetSpell = sortedSpells[0]; 
        for (const spell of sortedSpells) {
          if (dSpell.includes(spell)) { currentActiveTargetSpell = spell; break; }
