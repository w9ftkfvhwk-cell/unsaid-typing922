    class SoundSystem {
      constructor() {
        this.ctx = null;
        this.sfxEnabled = true;
        this.bgmEnabled = false; 
        this.synth = window.speechSynthesis;
        this.currentTrack = 1;
        this.bgmTimer = null;
        this.bgmStep = 0;
        this.voiceRate = 0.9;
      }
      init() {
        if (!this.ctx) this.ctx = new (window.AudioContext || window.webkitAudioContext)();
        if (this.ctx.state === 'suspended') this.ctx.resume();
      }
      playHit(f=440, type='triangle') {
        if (!this.sfxEnabled) return;
        this.init();
        const now = this.ctx.currentTime;
        const playTone = (freq, delay) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = type; 
          osc.frequency.setValueAtTime(freq, now + delay);
          gain.gain.setValueAtTime(0.15, now + delay);
          gain.gain.exponentialRampToValueAtTime(0.01, now + delay + 0.15);
          osc.connect(gain); gain.connect(this.ctx.destination);
          osc.start(now + delay); osc.stop(now + delay + 0.15);
        };
        playTone(f, 0);           
        playTone(f * 1.25, 0.03); 
      }
      playError() {
        if (!this.sfxEnabled) return;
        this.init();
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'square'; 
        osc.frequency.setValueAtTime(120, this.ctx.currentTime);
        osc.frequency.linearRampToValueAtTime(80, this.ctx.currentTime + 0.15);
        gain.gain.setValueAtTime(0.1, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.15);
        osc.connect(gain); gain.connect(this.ctx.destination);
        osc.start(); osc.stop(this.ctx.currentTime + 0.15);
      }
      speakEnglish(text) {
        if (!this.sfxEnabled || !this.synth) return;
        try {
          this.synth.cancel();
          const clean = text.replace(/[^a-zA-Z]/g, '');
          if (!clean) return;
          const u = new SpeechSynthesisUtterance(clean);
          u.lang = 'en-US';
          u.rate = this.voiceRate;
          this.synth.speak(u);
        } catch(e){}
      }
      changeVoiceRate(rate) { this.voiceRate = rate; }
      toggleBGM() {
        this.init(); 
        this.bgmEnabled = !this.bgmEnabled;
        const bs = document.getElementById('bgmStatus');
        const bi = document.getElementById('bgmIcon');
        if (this.bgmEnabled) { 
          bs.textContent = 'BGM 再生中'; bs.className = 'text-xs font-mono font-bold text-amber-300 animate-pulse'; 
          bi.textContent = '⏸️';
          this.startAmbientBGM();
        } else { 
          bs.textContent = 'BGM 停止'; bs.className = 'text-xs font-mono font-bold text-slate-400'; 
          bi.textContent = '▶️';
          this.stopAmbientBGM();
        }
      }
      changeTrack(trackNum) {
        this.currentTrack = trackNum;
        if (this.bgmEnabled) {
          this.stopAmbientBGM();
          this.startAmbientBGM();
        }
      }
      startAmbientBGM() {
        this.init();
        this.stopAmbientBGM();
        this.bgmStep = 0;
        const scheduleNext = () => {
          if (!this.bgmEnabled || !this.ctx) return;
          let chords = [], filterFreq = 380, intervalSec = 3.6, volume = 0.08; 
          if (this.currentTrack === 1) { 
            chords = [[261.63, 329.63, 392.00, 493.88], [220.00, 261.63, 329.63, 392.00], [174.61, 261.63, 329.63, 349.23]];
            intervalSec = 3.6; filterFreq = 500; volume = 0.08;
          } else if (this.currentTrack === 2) { 
            chords = [[392.00, 493.88, 587.33], [349.23, 440.00, 523.25]];
            intervalSec = 2.0; filterFreq = 1000; volume = 0.06;
          } else { 
            chords = [[110.00, 164.81], [98.00, 146.83], [123.47, 174.61]];
            intervalSec = 2.5; filterFreq = 300; volume = 0.1;
          }
          const currentChord = chords[this.bgmStep % chords.length];
          this.bgmStep++;
          const now = this.ctx.currentTime;
          currentChord.forEach(freq => {
            try {
              const osc = this.ctx.createOscillator();
              const gain = this.ctx.createGain();
              const filter = this.ctx.createBiquadFilter();
              osc.type = (this.currentTrack === 3) ? 'sawtooth' : 'triangle';
              osc.frequency.value = freq;
              filter.type = 'lowpass'; filter.frequency.value = filterFreq;
              gain.gain.setValueAtTime(0, now);
              gain.gain.linearRampToValueAtTime(volume, now + (intervalSec * 0.3));
              gain.gain.linearRampToValueAtTime(0, now + intervalSec);
              osc.connect(filter); filter.connect(gain); gain.connect(this.ctx.destination);
              osc.start(now); osc.stop(now + intervalSec);
            } catch(e){}
          });
          this.bgmTimer = setTimeout(scheduleNext, intervalSec * 1000);
        };
        scheduleNext();
      }
      stopAmbientBGM() {
        if (this.bgmTimer) { clearTimeout(this.bgmTimer); this.bgmTimer = null; }
      }
    }
