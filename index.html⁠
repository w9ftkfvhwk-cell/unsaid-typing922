        correctCount++; combo++; maxCombo = Math.max(combo, maxCombo);
        feverGauge = Math.min(100, feverGauge + 15);
        score += (100 + combo * 25);
        sound.playHit(500);
      } else {
        recordMistake(currentTarget);
        combo = 0; feverGauge = Math.max(0, feverGauge - 25);
        sound.playError();
        document.body.classList.add('shake');
        setTimeout(() => document.body.classList.remove('shake'), 250);
      }
      document.getElementById('hudScore').textContent = score;
      document.getElementById('hudCombo').textContent = combo;
      document.getElementById('feverBar').style.width = `${feverGauge}%`;
      cancelAnimationFrame(fallAnimFrame);
      spawnNextFallingQuestion();
      updateFallingPhysics();
    }
    
    function handleCharInput(char) {
      if (!isQuestionActive || (gamePlayMode !== 'typing' && gamePlayMode !== 'kimaru')) return;
      if (char === 'DEL' || char === 'Backspace') {
        typedBuffer = typedBuffer.slice(0, -1);
      } else {
        const expectedChar = currentActiveTargetSpell[typedBuffer.length];
        if (expectedChar && char.toLowerCase() === expectedChar.toLowerCase()) {
          typedBuffer += char.toLowerCase();
          sound.playHit(520);
        } else {
          recordMistake(currentTarget);
          sound.playError(); combo = 0; feverGauge = Math.max(0, feverGauge - 25);
          document.getElementById('hudCombo').textContent = combo;
          document.getElementById('feverBar').style.width = `${feverGauge}%`;
          document.body.classList.add('shake');
          setTimeout(() => document.body.classList.remove('shake'), 250);
          return;
        }
      }
      const underscores = "_".repeat(Math.max(0, currentActiveTargetSpell.length - typedBuffer.length));
      document.getElementById('typedBufferDisplay').textContent = typedBuffer + underscores;
      if (typedBuffer === currentActiveTargetSpell) {
        if (gamePlayMode === 'kimaru') window.kimaruDerivedIndex++;
        handleAnswer(true);
      }
    }

    window.addEventListener('keydown', (e) => {
      if (!isQuestionActive || (gamePlayMode !== 'typing' && gamePlayMode !== 'kimaru')) return;
      const key = e.key;
      if (e.ctrlKey || e.altKey || e.metaKey) return;
      if (key === 'Backspace' || key === 'Delete') { handleCharInput('DEL'); e.preventDefault(); }
      else if (/^[a-zA-Z]$/.test(key)) handleCharInput(key.toLowerCase());
    });

    function initVirtualKeyboard() {
      const kb1 = document.getElementById('kbRow1'), kb2 = document.getElementById('kbRow2'), kb3 = document.getElementById('kbRow3');
      kb1.innerHTML=''; kb2.innerHTML=''; kb3.innerHTML='';
      const makeBtn = c => {
        const b = document.createElement('button');
        b.className = "px-3 py-3 bg-black/40 border border-sepiaGold/40 rounded-lg text-sm sm:text-base font-mono font-bold active:scale-95 text-amber-100 min-w-[2.5rem] hover:bg-amber-800/60 hover:text-white transition shadow-sm";
        b.textContent = c.toUpperCase();
        b.onclick = () => handleCharInput(c);
        return b;
      };
      ['q','w','e','r','t','y','u','i','o','p'].forEach(c => kb1.appendChild(makeBtn(c)));
      ['a','s','d','f','g','h','j','k','l'].forEach(c => kb2.appendChild(makeBtn(c)));
      ['z','x','c','v','b','n','m','DEL'].forEach(c => kb3.appendChild(makeBtn(c)));
    }

    function endGame() {
      clearTimeout(timerId); cancelAnimationFrame(fallAnimFrame);
      isQuestionActive = false; gameScreen.classList.add('hidden'); resultScreen.classList.remove('hidden');
      const acc = totalAttempts > 0 ? Math.round((correctCount / totalAttempts) * 100) : 0;
      document.getElementById('resultScore').textContent = score;
      document.getElementById('resultCombo').textContent = maxCombo;
      document.getElementById('resultAccuracy').textContent = `${acc}%`;
      const elapsedSec = (isExamMode || isSingleDerivedAutoPlay || gamePlayMode === 'kimaru') ? Math.max(1, timeLeft) : 60;
      document.getElementById('resultSpeed').textContent = Math.round((correctCount / elapsedSec) * 60);

      const isPassed = acc >= 70 && score >= 1500;
      const nextBtn = document.getElementById('nextStageBtn');
      if (isPassed && currentStageIndex + 1 < stageMasterData[selectedOrigin].length && !isExamMode && !isSingleDerivedAutoPlay) {
        document.getElementById('passNotification').classList.remove('hidden');
        nextBtn.classList.remove('hidden');
        nextBtn.onclick = () => { currentStageIndex++; startGameWithPool(stageMasterData[selectedOrigin][currentStageIndex].items); };
      } else {
        document.getElementById('passNotification').classList.add('hidden');
        nextBtn.classList.add('hidden');
      }
    }

    function restartGame() { if (currentPool.length > 0) startGameWithPool(currentPool); }

    function changeTheme(theme) {
      document.body.classList.remove('theme-midnight', 'theme-emerald');
      if (theme !== 'sepia') document.body.classList.add('theme-' + theme);
    }

    setGamePlayMode(gamePlayMode); 
    selectRootOrigin(selectedOrigin); 
    setSpeedLevel(speedLevel);
  </script>
</body>
</html>

