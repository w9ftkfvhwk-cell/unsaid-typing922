    function updateFallingPhysics() {
      if (gameScreen.classList.contains('hidden') || !isQuestionActive) return;
      if (gamePlayMode === 'kimaru') { fallAnimFrame = requestAnimationFrame(updateFallingPhysics); return; }
      const now = performance.now(); const elapsed = now - questionStartTime;
      const currentDuration = Math.max(4000, questionDuration - (combo * 200));
      let progress = elapsed / currentDuration;
      if (progress > 1) progress = 1;
      const barFill = document.getElementById('deadlineBarFill');
      if (barFill) barFill.style.width = `${(1 - progress) * 100}%`;
      if (gamePlayMode === 'choice' && distractorBtnElements.length > 0) {
        if (progress > 0.4 && !distractorBtnElements[0].dataset.elim) eliminateDistractor(0);
        if (progress > 0.7 && distractorBtnElements.length > 1 && !distractorBtnElements[1].dataset.elim) eliminateDistractor(1);
      }
      if (progress >= 1) handleAnswer(false);
      else fallAnimFrame = requestAnimationFrame(updateFallingPhysics);
    }

